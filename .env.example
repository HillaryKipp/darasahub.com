APP_NAME=DarasaHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://darasahub.com
APP_CANONICAL_HOST=darasahub.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# HostAfrica DirectAdmin MariaDB / MySQL (fill in local .env only; never commit secrets)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Shared-hosting safe drivers (no Redis, no queue workers)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=file
RESPONSE_CACHE_LIFETIME=3600

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@darasahub.com"
MAIL_FROM_NAME="${APP_NAME}"

# No-SSH Maintenance Route (DISABLED by default — enable temporarily only when needed)
MAINTENANCE_ROUTE_ENABLED=false
MAINTENANCE_ROUTE_TOKEN=
MAINTENANCE_ROUTE_EXPIRES_AT=
MAINTENANCE_ROUTE_ALLOWED_IPS=

VITE_APP_NAME="${APP_NAME}"
